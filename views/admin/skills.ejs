<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Skills - Admin Panel</title>
  <link href="https://fonts.googleapis.com/css?family=Heebo:400,700|Roboto:400,500" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-main">
      <div class="admin-header">
        <h2>Skills</h2>
      </div>

      <h3>Tambah Baru</h3>
      <form method="POST" action="/admin/skills" class="admin-form">
        <div class="form-row">
          <div class="form-group">
            <label>Nama Skill</label>
            <input type="text" name="name" required>
          </div>
          <div class="form-group">
            <label>Kategori</label>
            <input type="text" name="category" placeholder="Frontend / Backend / dll">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Level (0-100)</label>
            <input type="number" name="level" min="0" max="100" value="50">
          </div>
          <div class="form-group">
            <label>Order Index</label>
            <input type="number" name="order_index" value="0">
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Tambah</button>
      </form>

      <hr>

      <h3>Daftar Skills</h3>
      <table class="admin-table">
        <thead>
          <tr><th>Skill</th><th>Kategori</th><th>Level</th><th>Action</th></tr>
        </thead>
        <tbody>
          <% skills.forEach(function(skill) { %>
          <tr>
            <form method="POST" action="/admin/skills/update/<%= skill.id %>">
              <td><input type="text" name="name" value="<%= skill.name %>" style="width:100%"></td>
              <td><input type="text" name="category" value="<%= skill.category %>" style="width:100%"></td>
              <td>
                <input type="number" name="level" value="<%= skill.level %>" min="0" max="100" style="width:60px">
              </td>
              <td class="action-cell">
                <input type="hidden" name="order_index" value="<%= skill.order_index %>">
                <button type="submit" class="btn btn-sm btn-primary">Update</button>
            </form>
            <form method="POST" action="/admin/skills/delete/<%= skill.id %>" style="display:inline">
              <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Hapus?')">Hapus</button>
            </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
  <script>
    console.log('[Admin Skills] Halaman dikelola');
    console.log('[Admin Skills] Total data:', '<%= skills.length %>');
  </script>
</body>
</html>
