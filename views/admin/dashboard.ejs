<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard - Admin Panel</title>
  <link href="https://fonts.googleapis.com/css?family=Heebo:400,700|Roboto:400,500" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
  <div class="admin-wrapper">
    <nav class="admin-sidebar">
      <div class="sidebar-header">
        <h3>Admin Panel</h3>
      </div>
      <ul class="sidebar-menu">
        <li><a href="/admin/dashboard" class="active"><i class="fa fa-dashboard"></i> Dashboard</a></li>
        <li><a href="/admin/profile"><i class="fa fa-user"></i> Profile</a></li>
        <li><a href="/admin/experiences"><i class="fa fa-briefcase"></i> Experience</a></li>
        <li><a href="/admin/education"><i class="fa fa-graduation-cap"></i> Education</a></li>
        <li><a href="/admin/skills"><i class="fa fa-cogs"></i> Skills</a></li>
        <li><a href="/admin/password"><i class="fa fa-key"></i> Password</a></li>
        <li><a href="/"><i class="fa fa-external-link"></i> Lihat CV</a></li>
        <li><a href="/admin/logout"><i class="fa fa-sign-out"></i> Logout</a></li>
      </ul>
    </nav>
    <main class="admin-main">
      <div class="admin-header">
        <h2>Dashboard</h2>
        <p>Selamat datang, <%= profile ? profile.name : 'Admin' %></p>
      </div>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon"><i class="fa fa-briefcase"></i></div>
          <div class="stat-info">
            <h3><%= stats.experiences %></h3>
            <p>Experience</p>
          </div>
          <a href="/admin/experiences" class="stat-link">Manage →</a>
        </div>
        <div class="stat-card">
          <div class="stat-icon"><i class="fa fa-graduation-cap"></i></div>
          <div class="stat-info">
            <h3><%= stats.education %></h3>
            <p>Education</p>
          </div>
          <a href="/admin/education" class="stat-link">Manage →</a>
        </div>
        <div class="stat-card">
          <div class="stat-icon"><i class="fa fa-cogs"></i></div>
          <div class="stat-info">
            <h3><%= stats.skills %></h3>
            <p>Skills</p>
          </div>
          <a href="/admin/skills" class="stat-link">Manage →</a>
        </div>
      </div>
      <div class="quick-links">
        <h3>Quick Actions</h3>
        <div class="quick-grid">
          <a href="/admin/profile" class="quick-btn">Edit Profile</a>
          <a href="/admin/experiences" class="quick-btn">Tambah Experience</a>
          <a href="/admin/education" class="quick-btn">Tambah Education</a>
          <a href="/admin/skills" class="quick-btn">Tambah Skill</a>
        </div>
      </div>
    </main>
  </div>
  <script>
    console.log('[Admin Dashboard] Halaman dashboard dimuat');
    console.log('[Admin Dashboard] Statistik:', {
      experiences: <%= stats.experiences %>,
      education: <%= stats.education %>,
      skills: <%= stats.skills %>
    });
    console.log('[Admin Dashboard] Profile:', { name: '<%= profile ? profile.name : "Admin" %>' });
  </script>
</body>
</html>
